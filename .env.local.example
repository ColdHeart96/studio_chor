# Supabase — copier dans .env.local et remplir les valeurs
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Sécurité iframe — domaine(s) autorisés à intégrer l'app (ex: votre site WordPress)
# Laisser vide pour restreindre à 'self' uniquement
# Exemple : NEXT_PUBLIC_FRAME_ANCESTORS='self' https://votre-site.com
NEXT_PUBLIC_FRAME_ANCESTORS=
